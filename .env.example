
# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║           NatDee-App — ENVIRONMENT VARIABLES TEMPLATE (.env.example)       ║
# ║                                                                              ║
# ║  ✅  ไฟล์นี้ปลอดภัยสำหรับ Commit เข้า Git                                 ║
# ║  ❌  ค่าทั้งหมดเป็น Dummy/Placeholder — ห้ามนำไปใช้งานจริงโดยตรง          ║
# ║                                                                              ║
# ║  วิธีใช้งาน:                                                                ║
# ║    1. คัดลอกไฟล์นี้: cp .env.example .env                                  ║
# ║    2. เติมค่าจริงทุกตัวใน .env                                              ║
# ║    3. เปิด .env ตรวจสอบให้ครบก่อน docker compose up                        ║
# ║    4. ห้าม Commit .env เด็ดขาด (มี .gitignore block แล้ว)                  ║
# ╚══════════════════════════════════════════════════════════════════════════════╝


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  [SECTION 1] MySQL Database Credentials                                     │
# │                                                                             │
# │  ใช้สำหรับ: Container "NatDee_mysql" (mysql:8.0)                          │
# │                                                                             │
# │  ถ้าเปลี่ยนค่าเหล่านี้ ต้องไปเปลี่ยนที่:                                 │
# │    📄 docker-compose.yml        → mysql.environment section                │
# │    🔧 n8n Credentials           → MySQL Node → "NatDee MySQL"              │
# │                                    (Settings → Credentials → MySQL)        │
# │    🌐 phpMyAdmin login          → ใช้ MYSQL_USER + MYSQL_PASSWORD ล็อคอิน  │
# │    📦 ถ้าเปลี่ยน MYSQL_DATABASE → ต้องไปเปลี่ยนใน n8n MySQL Node ด้วย     │
# └─────────────────────────────────────────────────────────────────────────────┘

MYSQL_ROOT_PASSWORD=CHANGE_ME_DUMMY_ROOT_PASS
MYSQL_DATABASE=appointment_bot
MYSQL_USER=CHANGE_ME_DUMMY_USER
MYSQL_PASSWORD=CHANGE_ME_DUMMY_USER_PASS


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  [SECTION 2] n8n Application Settings                                       │
# │                                                                             │
# │  ใช้สำหรับ: Container "n8n" (n8nio/n8n:latest)                            │
# │                                                                             │
# │  ถ้าเปลี่ยน N8N_WEBHOOK_URL ต้องไปเปลี่ยนที่:                             │
# │    📄 docker-compose.yml        → n8n.environment.WEBHOOK_URL              │
# │    🌐 natdee-app/config.js      → CONFIG.API.APPOINTMENTS / STATS          │
# │       (เพราะ Webhook URL ที่ Frontend ใช้ต้องตรงกับ Domain นี้)            │
# │    🔧 Cloudflare DNS / Nginx    → ถ้าเปลี่ยน Domain ต้องอัปเดต Routing     │
# └─────────────────────────────────────────────────────────────────────────────┘

N8N_WEBHOOK_URL=https://CHANGE_ME_YOUR_DOMAIN.com/


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  [SECTION 3] Cloudflare Tunnel Token                                        │
# │                                                                             │
# │  ใช้สำหรับ: Container "cloudflared_tunnel"                                 │
# │             (ทำหน้าที่ expose n8n:5678 ออก Internet ผ่าน Cloudflare)      │
# │                                                                             │
# │  วิธีดู Token ใหม่:                                                         │
# │    🌐 Cloudflare Dashboard → Zero Trust → Networks → Tunnels               │
# │       → เลือก Tunnel ของโปรเจกต์ → Configure → "Regenerate Token"         │
# │       → คัดลอก Token มาใส่ใน .env (ไม่ใช่ที่นี่!)                         │
# └─────────────────────────────────────────────────────────────────────────────┘

CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_YOUR_CLOUDFLARE_TUNNEL_TOKEN

